# Copy to .env and fill in. Never commit .env.

# Render: Dashboard → Account Settings → API Keys
RENDER_API_KEY=

# PayPal sandbox: developer.paypal.com → Apps & Credentials (Sandbox) → your app
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Sandbox personal (buyer) account email: Testing Tools → Sandbox Accounts
PAYPAL_SANDBOX_BUYER_EMAIL=
# Public URL that receives PayPal webhooks (tunnel or Render), spike 1c
WEBHOOK_URL=
# Filled after you register the webhook (spike 1)
PAYPAL_WEBHOOK_ID=

# LLM provider for invoice parsing and reminder drafting
ANTHROPIC_API_KEY=

# Bearer token for GET /events on the webhook server (generate: openssl rand -hex 24)
ADMIN_TOKEN=



# Client connect pages: cookie signing secret and the public app origin
SESSION_SECRET=
APP_URL=http://localhost:3000

# Postgres (Render). Local dev uses the external URL with sslmode=require
DATABASE_URL=

# Freelancer sign-in for /invoices, and the name shown on invoices
FREELANCER_NAME=
FREELANCER_PASSCODE=
# Optional: model for invoice drafting (default claude-opus-5-5)
ANTHROPIC_MODEL=
